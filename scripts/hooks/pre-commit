#!/bin/sh
# 이론 노트(lectures/weekNN/notes.md)가 스테이징되면 합본 lectures/이론_전체.md 를
# 재생성해 함께 커밋한다. 원본과 합본이 어긋나지 않게 유지하는 자동화.
#
# 활성화: git config core.hooksPath scripts/hooks   (클론마다 1회)

set -e

repo_root=$(git rev-parse --show-toplevel)

# 스테이징된 파일 중 이론 노트가 있는지 확인
if git diff --cached --name-only | grep -Eq '^lectures/week[0-9]{2}/notes\.md$'; then
    python3 "$repo_root/scripts/build_theory_book.py" >/dev/null
    git add "$repo_root/lectures/이론_전체.md"
fi
