# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Data / outputs
*.log
outputs/
checkpoints/
!labs/checkpoints/
*.ckpt
wandb/

# Secrets
.env
*.key

# Paper PDFs (re-downloadable via scripts/fetch_papers.py)
papers/*.pdf

# Downloaded reference repos (re-fetch via materials/fetch_materials.sh)
materials/repos/

# Site build artifacts (generated by site/build.sh + quarto render)
site/_site/
site/.quarto/
site/_api-setup-content.md

# Local-only: superseded notebook drafts
labs/_legacy/

# Rendered presentation sample (source: slides.qmd)
lectures/presentation-sample/slides.html
lectures/presentation-sample/slides_files/

# Rendered materials, regenerated in place by site/build.sh so each
# lectures/weekNN/ folder is browsable (sources: notes.en.md, slides.qmd)
lectures/week*/notes.html
lectures/week*/slides.html
lectures/week*/slides_files/
lectures/week*/notes_files/

# Review copies (regenerated: PDF export + contact sheets of the deck)
lectures/week*/_review/slides.pdf
lectures/week*/_review/slides-overview-*.png

# Third-party source copies in lectures/week*/reference/ stay local-only: the
# repo is public (Colab opens notebooks from it), and republishing full texts
# (Anthropic/OpenAI articles, DeepLearning.AI learner slides) is not ours to do.
# Only README.md — the course-authored source map with re-fetch commands — is tracked.
lectures/week*/reference/*
!lectures/week*/reference/README.md
# Zipped bundle of the reference folder (rebuild: cd lectures/weekNN && zip -r weekNN-reference.zip reference/)
lectures/week*/week*-reference.zip
